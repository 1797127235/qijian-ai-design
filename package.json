{
  "name": "qijian-ai-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file=.env apps/server/src/index.ts",
    "dev:worker": "tsx watch --env-file=.env apps/server/src/task-worker.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "benchmark:cache": "tsx --env-file=.env scripts/run-agent-cache-benchmark.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bull-board/api": "^8.6.0",
    "@bull-board/hono": "^8.6.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@napi-rs/canvas": "^1.0.3",
    "@vitejs/plugin-react": "latest",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "ioredis": "^5.11.1",
    "langsmith": "^0.8.9",
    "lucide-react": "latest",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.10",
    "undici": "^8.10.0",
    "vite": "latest",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.5",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
