DATABASE_URL=postgresql://qijian:qijian@localhost:5433/qijian
PORT=8787
API_CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=data/uploads
PUBLIC_BASE_URL=http://localhost:8787
AGENT_PROVIDER=codex2api
AGENT_MODEL=grok-4.5-latest
# —— 主生图网关（例如 codex2api / grok）——
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=grok-imagine-image-quality
IMAGE_EDIT_MODEL=grok-imagine-image-quality
# 主站面板模型列表（逗号分隔）；不填则用内置 grok-imagine 默认集 + IMAGE_MODEL
# IMAGE_MODEL_OPTIONS=grok-imagine-image,grok-imagine-image-pro,grok-imagine-image-quality
# IMAGE_PROVIDER_ID=primary
# IMAGE_PROVIDER_LABEL=Grok

# —— 附加网关 2…5（面板选 model 时自动路由到对应 URL/Key）——
# IMAGE_PROVIDER_2_URL=http://openai2api.com:3000/v1
# IMAGE_PROVIDER_2_KEY=
# IMAGE_PROVIDER_2_MODELS=gpt-image-2
# IMAGE_PROVIDER_2_ID=openai2api
# IMAGE_PROVIDER_2_LABEL=OpenAI2API

# 结果图 URL 下载代理（可选；也认 HTTPS_PROXY / https_proxy）
# IMAGE_FETCH_PROXY=http://127.0.0.1:7897
# 默认出图尺寸（可选）：auto 不写；或 1:1 / 16:9 / 1024x1024；面板选择会覆盖
# IMAGE_SIZE=
# 文本/视觉 LLM（项目自动起名 + 图片 caption）
# 可不填：会从 IMAGE_API_URL 推导同源 /v1/chat/completions，密钥回退 IMAGE_API_KEY
# TEXT_API_URL=
# TEXT_API_KEY=
# TEXT_MODEL=grok-4.5-latest
# 探针：=1 时注册 debug_return_image（toolResult 内联图，验证路径 A）
# AGENT_DEBUG_IMAGE_TOOL=1
PLAYWRIGHT_CHROMIUM_PATH=

# H7 Agent 观测（LangSmith 云；默认关）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pi
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_DEBUG_SYNC=true
# 模型 usage / prompt cache 一行 JSON 日志（message_end；默认关）
# AGENT_LOG_USAGE=1

